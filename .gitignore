# ═══════════════════════════════════════════════════════════════
# Cognix — Git Ignore Rules
# ═══════════════════════════════════════════════════════════════

# ─── Environment ───────────────────────────────────────────────
# CRITICAL: Never commit secrets!
.env
.env.local
.env.production
*.pem
*.key

# ─── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# ─── Node.js ──────────────────────────────────────────────────
node_modules/
.next/
out/

# ─── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ─── Testing ──────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ─── Docker ───────────────────────────────────────────────────
# Don't ignore docker-compose.yml (it should be committed)
# But ignore local overrides
docker-compose.override.yml

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ─── Data ─────────────────────────────────────────────────────
# Uploaded documents (stored in object storage in production)
uploads/
data/
